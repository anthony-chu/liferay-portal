{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"module": "preserve",
		"moduleResolution": "bundler",
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"target": "es2022",
		"types": [
			"node"
		]
	},
	"include": [
		"langfuse-evals/**/*.ts",
		"lmnr-evals/**/*.ts"
	]
}