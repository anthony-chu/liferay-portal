<html>
<head>
<title>SiteNavigationMenu</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">SiteNavigationMenu</td></tr>
</thead>
<tbody>
<tr>
	<td>ITEM_ENTRY</td>
	<td>//div[contains(@class,'navigation-menu-item')][@data-title='${key_itemName}']</td>
	<td></td>
</tr>
<tr>
	<td>ITEM_ENTRY_N</td>
	<td>xpath=(//div[contains(@class,'navigation-menu-item')])[${key_index}]</td>
	<td></td>
</tr>
<tr>
	<td>ITEM_ENTRY_STICKER</td>
	<td>//div[contains(@class,'navigation-menu-item')][@data-title='${key_itemName}']//span[*[name()='svg'][contains(@class,'icon')]]</td>
	<td></td>
</tr>
<tr>
	<td>ITEM_LINK</td>
	<td>//div[@class='card-body']//a[normalize-space()='${key_item}']</td>
	<td></td>
</tr>
<tr>
	<td>APPLICATION_SELECT</td>
	<td>//select[contains(@id,'fullPageApplication')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>