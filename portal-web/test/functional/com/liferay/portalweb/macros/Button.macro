<definition>
	<command name="click">
		<execute function="ScrollWebElementIntoView" locator1="Button#ANY">
			<var name="key_fieldLabel" value="${fieldLabel}" />
		</execute>

		<execute function="Click" locator1="Button#ANY">
			<var name="key_fieldLabel" value="${fieldLabel}" />
		</execute>
	</command>

	<command name="viewNotPresent">
		<execute function="AssertElementNotPresent" locator1="Button#ANY">
			<var name="key_fieldLabel" value="${fieldLabel}" />
		</execute>
	</command>

	<command name="viewPresent">
		<execute function="AssertElementPresent" locator1="Button#ANY">
			<var name="key_fieldLabel" value="${fieldLabel}" />
		</execute>
	</command>

	<command name="clickAddRow">
		<execute function="Click" locator1="Button#ADD_ROW" />
	</command>

	<command name="clickCancel">
		<execute macro="Button#click">
			<var name="fieldLabel" value="Cancel" />
		</execute>
	</command>

	<command name="clickConfirm">
		<execute macro="Button#click">
			<var name="fieldLabel" value="Confirm" />
		</execute>
	</command>

	<command name="clickDelete">
		<execute macro="Button#click">
			<var name="fieldLabel" value="Delete" />
		</execute>
	</command>

	<command name="clickDone">
		<execute macro="Button#click">
			<var name="fieldLabel" value="Done" />
		</execute>
	</command>

	<command name="clickInstall">
		<execute macro="Button#click">
			<var name="fieldLabel" value="Install" />
		</execute>
	</command>

	<command name="clickNext">
		<execute macro="Button#click">
			<var name="fieldLabel" value="Next" />
		</execute>
	</command>

	<command name="clickPublish">
		<execute macro="Button#click">
			<var name="fieldLabel" value="Publish" />
		</execute>
	</command>

	<command name="clickRemove">
		<execute macro="Button#click">
			<var name="fieldLabel" value="Remove" />
		</execute>
	</command>

	<command name="clickSave">
		<execute macro="Button#click">
			<var name="fieldLabel" value="Save" />
		</execute>
	</command>

	<command name="clickSaveAsDraft">
		<execute macro="Button#click">
			<var name="fieldLabel" value="Save as Draft" />
		</execute>
	</command>

	<command name="clickSubmitForPublication">
		<execute macro="Button#click">
			<var name="fieldLabel" value="Submit for Publication" />
		</execute>
	</command>

	<command name="clickSubmitLocalized">
		<execute macro="Button#click">
			<var name="fieldLabel" value="${buttonName}" />
		</execute>
	</command>

	<command name="clickUpdate">
		<execute macro="Button#click">
			<var name="fieldLabel" value="Update" />
		</execute>
	</command>
</definition>