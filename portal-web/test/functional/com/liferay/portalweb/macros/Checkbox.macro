<definition>
	<command name="disable">
		<execute function="Uncheck" locator1="Checkbox#ANY">
			<var name="key_fieldLabel" value="${fieldLabel}" />
		</execute>
	</command>

	<command name="enable">
		<execute function="Check" locator1="Checkbox#ANY">
			<var name="key_fieldLabel" value="${fieldLabel}" />
		</execute>
	</command>

	<command name="viewDisabled">
		<execute function="AssertNotChecked" locator1="Checkbox#ANY">
			<var name="key_fieldLabel" value="${fieldLabel}" />
		</execute>
	</command>

	<command name="viewEnabled">
		<execute function="AssertChecked" locator1="Checkbox#ANY">
			<var name="key_fieldLabel" value="${fieldLabel}" />
		</execute>
	</command>

	<command name="viewNotPresent">
		<execute function="AssertElementNotPresent" locator1="Checkbox#ANY">
			<var name="key_fieldLabel" value="${fieldLabel}" />
		</execute>
	</command>

	<command name="viewPresent">
		<execute function="AssertElementPresent" locator1="Checkbox#ANY">
			<var name="key_fieldLabel" value="${fieldLabel}" />
		</execute>
	</command>
</definition>