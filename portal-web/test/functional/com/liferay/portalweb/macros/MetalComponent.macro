definition {
	macro waitForComponent {
		AssertElementPresent(locator1 = "${locator}");

		AssertVisible(locator1 = "${locator}");

		var id = selenium.getAttribute("${locator}@id");

		var javaScript = '''
var isReady = "false";

if (Liferay.component("${id}") !== undefined) {
	Liferay.componentReady("${id}").then(
		isReady = "true"
	);
}

return isReady;
''';

		var componentReady = "";

		while (!("${componentReady}" == "true") && (maxIterations = "30")) {
			var componentReady = selenium.getEval("${javaScript}");

			Pause(locator1 = "1000");
		}
	}

	macro waitForLayout {
		MetalComponent.waitForComponent(
			locator = '''//div[@class='portlet-body']/form/div'''
		);
	}

	macro waitForManagementBar {
		MetalComponent.waitForComponent(
			locator = '''//div[nav[contains(@class,'management-bar')]]'''
		);
	}

	macro waitForNavigationBar {
		MetalComponent.waitForComponent(
			locator = '''//nav[contains(@class,'navigation-bar')]'''
		);
	}
}