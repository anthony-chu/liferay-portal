definition {
	macro waitForComponent {
		AssertElementPresent(locator1 = "${locator}");

		AssertVisible(locator1 = "${locator}");

		var id = selenium.getAttribute("${locator}@id");

		var javaScript = '''
var isReady = "false";

if (Liferay.component("${id}") !== undefined) {
	Liferay.componentReady("${id}").then(
		isReady = "true"
	);
}

return isReady;
''';

		var componentReady = "";

		while (!("${componentReady}" == "true") && (maxIterations = "120")) {
			var componentReady = selenium.getEval("${javaScript}");

			Pause(locator1 = "1000");
		}
	}

	macro waitForLayout {
		MetalComponent.waitForMetalComponent(
			locator = '''//div[@class='portlet-body']/form/div'''
		);
	}

	macro waitForManagementBar {
		MetalComponent.waitForMetalComponent(
			locator = '''//div[nav[contains(@class,'management-bar')]]'''
		);
	}

	macro waitForMetalComponent {
		var javaScript = '''
var metalComponent = Liferay.component(${id});

if (metalComponent !== undefined) {
	if (metalComponent.wasRendered) {
		return 'ready';
	}
	else {
		return 'pending';
	}
}
else {
	return 'pending';
}
		''';
		var metalComponentReady = "";

		while (!("${metalComponentReady}" == "ready") && (maxIterations = "30")) {
			var metalComponentReady = selenium.getEval("${javaScript}");

			Pause(locator1 = "1000");
		}
	}
}

	macro waitForNavigationBar {
		MetalComponent.waitForComponent(
			locator = '''//nav[contains(@class,'navigation-bar')]'''
		);
	}
}