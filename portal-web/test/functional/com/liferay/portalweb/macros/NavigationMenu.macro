<definition>
	<command name="gotoAddPage">
		<execute macro="Portlet#clickPortletPlusIconPG">
			<var name="portletName" value="Navigation Menu" />
		</execute>

		<execute function="Click" locator1="MenuItem#ANY_MENU_ITEM">
			<var name="key_menuItem" value="Add Page" />
		</execute>
	</command>

	<command name="goToPropertiesSidebar">
		<execute function="Click" locator1="ContentTargeting#CARD_CONTENT_TITLE">
			<var name="key_contentTitle" value="${contentTitle}" />
		</execute>

		<execute function="AssertTextEquals" locator1="Navigation#SIDEBAR_HEADER" value1="${contentTitle}">
			<var name="key_contentTitle" value="${contentTitle}" />
		</execute>
		<execute function="AssertTextEquals" locator1="TextInput#TITLE" value1="${contentTitle}" />
	</command>

	<command name="selectAndSaveConfiguration">
		<execute function="SelectFrame" locator1="IFrame#CONFIGURATION" />

		<execute function="Select" locator1="Select#DISPLAY_TEMPLATE" value1="${displayTemplate}" />

		<execute macro="PortletEntry#save" />

		<execute function="SelectFrame" value1="relative=top" />
	</command>
</definition>