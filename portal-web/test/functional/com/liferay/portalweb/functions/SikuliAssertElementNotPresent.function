<definition default="sikuliAssertElementNotPresent">
	<command name="sikuliAssertElementNotPresent">
		<execute selenium="sikuliAssertElementNotPresent" />

		<execute selenium="assertJavaScriptErrors" />

		<execute selenium="assertLiferayErrors" />

		<execute function="WaitForScript#waitForScript" />
	</command>
</definition>